{
  "name": "obsidian-vivid",
  "version": "0.3.1",
  "description": "ChatGPT and Claude-grade interactive visual rendering fused with Bases, Canvas, Properties, and Wikilinks: sortable super-tables, offline ECharts, live vault analytics, pan-zoom SVGs, KPI cards, and sandboxed HTML artifacts.",
  "author": "A-Znk (https://github.com/Yuki-zik)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuki-zik/obsidian-vivid.git"
  },
  "homepage": "https://github.com/Yuki-zik/obsidian-vivid#readme",
  "bugs": {
    "url": "https://github.com/Yuki-zik/obsidian-vivid/issues"
  },
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "sync": "pnpm run build && node scripts/sync-vaults.mjs",
    "promo": "node scripts/record-promo-video.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "vivid",
    "obsidian-plugin",
    "obsidian-bases",
    "obsidian-canvas",
    "chatgpt",
    "claude-artifacts",
    "generative-ui",
    "echarts",
    "svg",
    "interactive-table"
  ],
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.2.4",
    "echarts": "^5.6.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "jsdom": "^25.0.1",
    "obsidian": "latest",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.2-alpha.11",
    "vitest": "^2.1.8"
  }
}
